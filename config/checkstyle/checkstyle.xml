<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
  Deliberately not Google's or Sun's stock config.

  Spotless already owns every whitespace, brace and line-length decision, so
  repeating those here would only produce two tools disagreeing. What is left
  is the set of checks a formatter cannot make: naming, real bug patterns, and
  a handful of rules that exist because this is a custody system handling
  money — no float arithmetic, no swallowed exceptions, no leaked printf
  debugging.

  Severity is `error` throughout. A warning nobody has to fix is a warning
  everybody ignores.
-->
<module name="Checker">
    <property name="severity" value="error"/>
    <property name="fileExtensions" value="java"/>

    <!-- Tabs vs spaces is not a debate worth having twice a year. -->
    <module name="FileTabCharacter"/>
    <module name="NewlineAtEndOfFile"/>

    <module name="TreeWalker">
        <!-- There is deliberately no SuppressionCommentFilter here.

             It was configured for `// CHECKSTYLE:OFF` / `:ON` around a
             genuinely unavoidable violation, on the grounds that it would be
             rare and visible in review. No file ever used one, and the safeguard
             was thinner than it looked: Checkstyle prints nothing when a comment
             suppresses a violation, so a `CHECKSTYLE:OFF` block produces a green
             `maxWarnings=0` run with no record anywhere in the build output that
             a rule was switched off. The rules it could silence include the ban
             on `float` and `double`, which this project treats as a correctness
             rule about money rather than a style preference — and "the gate
             passed" and "the gate ran" should not be able to come apart there.

             If an escape hatch is ever genuinely needed, add a
             SuppressionXpathFilter backed by a checked-in suppressions.xml, so
             that every suppression sits in one file a reviewer can read on its
             own rather than scattered through the sources. -->

        <!-- ==== Naming ==================================================== -->
        <module name="PackageName">
            <property name="format" value="^[a-z]+(\.[a-z][a-z0-9]*)*$"/>
        </module>
        <module name="TypeName"/>
        <module name="MethodName"/>
        <module name="ParameterName"/>
        <module name="LocalVariableName"/>
        <module name="MemberName"/>
        <module name="StaticVariableName"/>
        <module name="ConstantName"/>
        <module name="RecordComponentName"/>
        <module name="LambdaParameterName"/>

        <!-- ==== Imports =================================================== -->
        <module name="UnusedImports"/>
        <module name="RedundantImport"/>
        <module name="AvoidStarImport"/>
        <module name="IllegalImport">
            <!-- sun.* is not API. junit.framework is JUnit 3. -->
            <property name="illegalPkgs" value="sun, junit.framework, org.junit.Assert"/>
        </module>

        <!-- ==== Correctness =============================================== -->
        <module name="EqualsHashCode"/>
        <module name="CovariantEquals"/>
        <module name="StringLiteralEquality"/>
        <module name="NoClone"/>
        <module name="NoFinalizer"/>
        <module name="SuperClone"/>
        <module name="EmptyStatement"/>
        <module name="FallThrough"/>
        <module name="MissingSwitchDefault"/>
        <module name="DefaultComesLast"/>
        <module name="SimplifyBooleanExpression"/>
        <module name="SimplifyBooleanReturn"/>
        <module name="ModifiedControlVariable"/>
        <module name="MultipleVariableDeclarations"/>
        <module name="OneStatementPerLine"/>
        <module name="PackageDeclaration"/>
        <module name="OuterTypeFilename"/>
        <module name="ArrayTypeStyle"/>
        <module name="UpperEll"/>
        <module name="HideUtilityClassConstructor">
            <!-- A Spring Boot entry point holds only `main`, which fits the
                 utility-class shape, but Spring instantiates it as a
                 configuration class: hiding the constructor breaks startup. -->
            <property name="ignoreAnnotatedBy" value="SpringBootApplication"/>
        </module>
        <module name="MissingOverride"/>

        <!-- Braces are not optional. `if (x) doThing();` is one careless diff
             away from a bug that reviewers do not see. -->
        <module name="NeedBraces"/>

        <!-- ==== Money and correctness-critical rules ====================== -->
        <!-- Wei amounts are numeric(78,0). A float anywhere near them is a
             rounding bug waiting for an auditor to find it. -->
        <module name="IllegalType">
            <property name="illegalClassNames" value="java.lang.Float, java.lang.Double"/>
            <property name="memberModifiers" value="LITERAL_PUBLIC, LITERAL_PROTECTED, LITERAL_PRIVATE, LITERAL_STATIC"/>
        </module>
        <module name="IllegalTokenText">
            <property name="tokens" value="NUM_DOUBLE, NUM_FLOAT"/>
            <property name="format" value="^.+$"/>
            <property name="message" value="Floating point literals are banned: monetary amounts are exact integers (wei)."/>
        </module>

        <!-- An empty catch block hides the failure that matters. Name the
             variable `ignored`/`expected` and say why, or handle it. -->
        <module name="EmptyCatchBlock">
            <property name="exceptionVariableName" value="ignored|expected"/>
        </module>
        <module name="IllegalCatch">
            <property name="illegalClassNames"
                      value="java.lang.Throwable, java.lang.Error, java.lang.RuntimeException"/>
        </module>
        <module name="IllegalThrows"/>

        <!-- printf debugging does not belong on a money path; use the logger. -->
        <module name="Regexp">
            <property name="format" value="System\.(out|err)\.print"/>
            <property name="illegalPattern" value="true"/>
            <property name="message" value="Use a logger, not System.out/System.err."/>
        </module>
        <!-- `printStackTrace()` throws the stack trace at stdout and swallows
             it everywhere logs are actually collected. -->
        <module name="Regexp">
            <property name="format" value="\.printStackTrace\(\)"/>
            <property name="illegalPattern" value="true"/>
            <property name="message" value="Log the exception instead of printStackTrace()."/>
        </module>

        <!-- A TODO with no ticket is a TODO nobody will do. -->
        <module name="TodoComment">
            <property name="format" value="(TODO|FIXME)(?!\s*\([A-Z]+-\d+\))"/>
            <property name="severity" value="warning"/>
        </module>

        <!-- ==== Size and complexity ======================================= -->
        <!-- Not style rules: a 20-branch method is where the edge case hides.
             Generous limits, so hitting one is a genuine signal. -->
        <module name="CyclomaticComplexity">
            <property name="max" value="12"/>
        </module>
        <module name="MethodLength">
            <property name="max" value="120"/>
        </module>
        <module name="ParameterNumber">
            <property name="max" value="8"/>
            <!-- Constructors of records and Spring beans legitimately take many. -->
            <property name="tokens" value="METHOD_DEF"/>
        </module>
        <module name="NestedTryDepth">
            <property name="max" value="2"/>
        </module>
        <module name="NestedIfDepth">
            <property name="max" value="3"/>
        </module>

        <!-- ==== Javadoc =================================================== -->
        <!-- Only that Javadoc which exists is well-formed. Mandating Javadoc on
             every member produces `/** Gets the id. */`, which is worse than
             nothing; this codebase explains itself in prose where it matters. -->
        <module name="JavadocMissingWhitespaceAfterAsterisk"/>
        <module name="NonEmptyAtclauseDescription"/>
        <module name="InvalidJavadocPosition"/>
    </module>
</module>
